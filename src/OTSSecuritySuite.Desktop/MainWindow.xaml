<Window x:Class="OTSSecuritySuite.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="OTS Security Suite · Ohana Tech Solutions" Icon="AppIcon.ico"
        Width="1300" Height="800" MinWidth="900" MinHeight="650"
        WindowStartupLocation="CenterScreen" Closing="OnWindowClosing" Loaded="OnWindowLoaded">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="96"/><RowDefinition Height="*"/><RowDefinition Height="35"/></Grid.RowDefinitions>
    <Border Background="#0B1510" BorderBrush="#28492F" BorderThickness="0,0,0,1" Grid.Row="0">
      <DockPanel Margin="24,12">
        <Image Source="OhanaLogo.png" Width="92" Height="69" Stretch="Uniform" DockPanel.Dock="Left" Margin="0,0,15,0"/>
        <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
          <TextBlock Text="OTS SECURITY SUITE" FontSize="24" FontWeight="Bold" Foreground="#F2FFF0"/>
          <TextBlock Text="OHANA TECH SOLUTIONS · LOCAL SECURITY TOOLS" Foreground="#9BC5A3" FontSize="11" Margin="0,3,0,0"/>
        </StackPanel>
        <Button Name="ProtectionHeader" Click="OpenProtectionFromHeader" Content="CHECKING ANTIVIRUS..." Foreground="#C7EACA" Background="#14271A" BorderBrush="#426C49" FontSize="12" FontWeight="Bold" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="10,7" ToolTip="View Windows antivirus protection status"/>
      </DockPanel>
    </Border>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="224"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" BorderBrush="#28492F" BorderThickness="0,0,1,0" Background="#0F1811">
        <StackPanel Margin="14,24,8,12">
          <TextBlock Text="SECURITY MODULES" Foreground="#8CA692" FontSize="11" Margin="8,0,0,14"/>
          <Button Name="RepoTab" Click="ShowRepository" Content="▣  REPOSCAN · REPOSITORY SECURITY" Foreground="#39FF14"/>
          <Button Name="SystemTab" Click="ShowSystem" Content="▤  WINDOWS SECURITY"/>
          <Button Name="NetworkTab" Click="ShowNetwork" Content="⌁  NETWORK DEFENSE"/>
          <Button Name="StrixTab" Click="ShowStrix" Content="◇  STRIX · AI PENTEST"/>
          <Border Background="#1C3020" CornerRadius="6" Margin="4,22,8,0" Padding="11">
            <TextBlock Text="REPOSCAN IS READ-ONLY BY DEFAULT&#10;&#10;Strix is separate, opt-in, and tests only an authorized disposable copy." Foreground="#B9D1BD" TextWrapping="Wrap" FontSize="12"/>
          </Border>
        </StackPanel>
      </Border>
      <Grid Grid.Column="1" Margin="18,16,18,10">
        <Grid Name="RepositoryPanel">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <TextBlock Text="REPOSCAN · MALWARE, SECRETS &amp; SOURCE SECURITY" Foreground="#39FF14" FontWeight="Bold" FontSize="13" Margin="2,0,0,12"/>
          <Border Grid.Row="1" Background="#0C140E" BorderBrush="#35543C" BorderThickness="1" CornerRadius="8">
            <Grid>
              <wv2:WebView2 Name="RepositoryBrowser" Visibility="Collapsed"/>
              <TextBlock Name="RepositoryLoading" Text="Starting local repository engine..." Foreground="#A9C4AF" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"/>
            </Grid>
          </Border>
        </Grid>
        <Grid Name="SystemPanel" Visibility="Collapsed">
          <StackPanel>
            <TextBlock Text="WINDOWS ANTIVIRUS STATUS" Foreground="#39FF14" FontWeight="Bold" FontSize="18" Margin="0,0,0,16"/>
            <Border Background="#14271A" BorderBrush="#3E6849" BorderThickness="1" CornerRadius="7" Padding="12" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Name="AntivirusSummary" Text="CHECKING · Registered antivirus status..." FontWeight="Bold" FontSize="15" Foreground="#E4F8E7" TextWrapping="Wrap"/>
                <TextBlock Name="AntivirusProducts" Text="Reading Windows Security Center..." Foreground="#B8D2BF" Margin="0,6,0,0" TextWrapping="Wrap"/>
                <TextBlock Name="AntivirusGuidance" Text="Antivirus status is read-only. OTS does not disable or replace installed antivirus." Foreground="#C6D9C8" Margin="0,5,0,0" TextWrapping="Wrap"/>
                <WrapPanel Margin="0,9,0,0"><Button Click="RefreshAntivirus" Content="REFRESH PROTECTION STATUS"/><Button Click="OpenWindowsSecurity" Content="OPEN WINDOWS SECURITY"/></WrapPanel>
              </StackPanel>
            </Border>
            <TextBlock Name="SystemStatus" Text="The Windows Security tab reports antivirus status. File cleanup and the former System Sanitizer module are not part of this application." Foreground="#A9CCA9" TextWrapping="Wrap" Margin="0,10,0,0"/>
          </StackPanel>
        </Grid>
        <Grid Name="NetworkPanel" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Text="NETWORK DEFENSE · READ-ONLY" Foreground="#39FF14" FontWeight="Bold" FontSize="18" Margin="0,0,0,14"/>
          <TextBlock Grid.Row="1" Text="Windows Firewall stays in charge. OTS inspects status and TCP connections without changing rules, starting a second firewall, or disabling Defender." TextWrapping="Wrap" Foreground="#B9D1BD" Margin="0,0,0,14"/>
          <WrapPanel Grid.Row="2" Margin="0,0,0,10"><Button Content="REFRESH NETWORK STATUS" Click="RefreshNetworkClick"/><Button Content="ANALYZE FIREWALL RULES" Click="AnalyzeFirewallRulesClick"/><Button Content="VIEW SECURITY EVENTS" Click="RefreshThreatActivityClick"/><Button Content="OPEN WINDOWS SECURITY" Click="OpenWindowsSecurityClick"/></WrapPanel>
          <StackPanel Grid.Row="3">
            <TextBlock Name="NetworkStatus" Text="Select Refresh to inspect Windows Firewall and active TCP connections." Foreground="#A9CCA9" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <TextBlock Name="FirewallRuleSummary" Text="Rule analysis has not been requested. No rules are changed automatically." Foreground="#A9CCA9" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <ItemsControl Name="NetworkProfiles">
              <ItemsControl.ItemTemplate><DataTemplate><TextBlock Foreground="#B9D1BD" Text="{Binding}" Margin="0,0,0,2"/></DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Name="NetworkCount" Foreground="#90B59B" Margin="0,10,0,10" Text="Connections have not been queried."/>
          </StackPanel>
          <TabControl Grid.Row="4" Margin="0,0,0,5">
            <TabItem Header="TCP CONNECTIONS">
              <ListView Name="NetworkConnections">
                <ListView.View><GridView>
                  <GridViewColumn Header="Local endpoint" DisplayMemberBinding="{Binding Local}" Width="265"/>
                  <GridViewColumn Header="Remote endpoint" DisplayMemberBinding="{Binding Remote}" Width="265"/>
                  <GridViewColumn Header="TCP state" DisplayMemberBinding="{Binding State}" Width="120"/>
                </GridView></ListView.View>
              </ListView>
            </TabItem>
            <TabItem Header="SECURITY ACTIVITY">
              <DockPanel>
                <TextBlock Name="ThreatActivityStatus" DockPanel.Dock="Top" Foreground="#B9D1BD" TextWrapping="Wrap"
                           Text="Select VIEW SECURITY EVENTS to read supported Windows Defender and Windows Firewall events. An event is not necessarily an attack." Margin="4,8,4,10"/>
                <ListView Name="ThreatActivityItems">
                  <ListView.View><GridView>
                    <GridViewColumn Header="Time" DisplayMemberBinding="{Binding Time}" Width="145"/>
                    <GridViewColumn Header="Source" DisplayMemberBinding="{Binding Source}" Width="125"/>
                    <GridViewColumn Header="Event" DisplayMemberBinding="{Binding EventId}" Width="55"/>
                    <GridViewColumn Header="Observation" DisplayMemberBinding="{Binding Summary}" Width="280"/>
                    <GridViewColumn Header="Outcome" DisplayMemberBinding="{Binding Outcome}" Width="230"/>
                  </GridView></ListView.View></ListView>
              </DockPanel>
            </TabItem>
          </TabControl>
        </Grid>
        <Grid Name="StrixPanel" Visibility="Collapsed">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,14,12">
              <TextBlock Text="STRIX · OPTIONAL AUTONOMOUS PENETRATION TESTING" Foreground="#39FF14" FontWeight="Bold" FontSize="18" Margin="0,0,0,12"/>
              <TextBlock Text="Separate Apache-2.0 Strix CLI and Docker are required. No Strix binary is bundled, installed or started automatically. This assessment can execute code, make network requests and consume substantial computing resources." Foreground="#C8DDCD" TextWrapping="Wrap" Margin="0,0,0,12"/>
              <TextBlock Text="Only a local source directory and numeric loopback AI-model endpoint are accepted. OTS copies the source into a capped disposable workspace; Strix may modify that copy. Docker network isolation is NOT guaranteed by this preview. Never use production secrets or a privileged Docker daemon." Foreground="#E0C987" TextWrapping="Wrap" Margin="0,0,0,13"/>
              <TextBlock Text="STRIX CLI EXECUTABLE (.exe)" Foreground="#A9CCA9"/>
              <DockPanel Margin="0,3,0,12"><Button DockPanel.Dock="Right" Click="ChooseStrixExecutable" Content="BROWSE"/><TextBox Name="StrixExecutable" Margin="0,0,8,0" MinWidth="180"/></DockPanel>
              <TextBlock Text="OWNED / AUTHORIZED LOCAL SOURCE FOLDER" Foreground="#A9CCA9"/>
              <DockPanel Margin="0,3,0,12"><Button DockPanel.Dock="Right" Click="ChooseStrixSource" Content="BROWSE"/><TextBox Name="StrixSource" Margin="0,0,8,0" MinWidth="180"/></DockPanel>
              <TextBlock Text="SELF-HOSTED MODEL IDENTIFIER (LiteLLM / OpenAI-compatible)" Foreground="#A9CCA9"/>
              <TextBox Name="StrixModel" Margin="0,3,0,12" Text="openai/local-model"/>
              <TextBlock Text="LOCAL MODEL ENDPOINT (LOOPBACK ONLY)" Foreground="#A9CCA9"/>
              <TextBox Name="StrixEndpoint" Margin="0,3,0,12" Text="http://127.0.0.1:11434/v1"/>
              <CheckBox Name="StrixAuthorization" Margin="0,0,0,13" Foreground="#E2F0E4" Content="I own or am expressly authorized to test this source and understand autonomous testing can execute code."/>
              <WrapPanel>
                <Button Name="StrixRunButton" Click="RunStrix" Content="RUN AUTHORIZED LOCAL TEST"/>
                <Button Name="StrixCancelButton" Click="CancelStrix" Content="CANCEL" IsEnabled="False"/>
                <Button Name="StrixReportsButton" Click="OpenStrixReports" Content="OPEN LOCAL REPORTS" IsEnabled="False"/>
              </WrapPanel>
              <TextBlock Name="StrixStatus" Margin="0,14,0,0" Foreground="#B9D1BD" TextWrapping="Wrap" Text="Strix is idle. No tests have been started."/>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Grid>
    </Grid>
    <Border Grid.Row="2" Background="#0B1510" BorderBrush="#28492F" BorderThickness="0,1,0,0">
      <DockPanel Margin="20,7"><TextBlock Text="OTS SECURITY SUITE · PRE-RELEASE ENGINE INTEGRATION" Foreground="#88A18C" FontSize="11" DockPanel.Dock="Left"/><TextBlock Text="© OHANA TECH SOLUTIONS" Foreground="#88A18C" DockPanel.Dock="Right" HorizontalAlignment="Right" FontSize="11"/></DockPanel>
    </Border>
  </Grid>
</Window>
